{
  "name": "smart-e-mobility-hub",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "npm run build:web && tsx src/api/server.ts",
    "build": "npm run typecheck && npm run build:web && tsc -p tsconfig.api.json",
    "build:web": "vite build",
    "start": "node dist/api/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pretest:e2e": "npm run build",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "dev:web": "vite"
  },
  "dependencies": {
    "@fastify/static": "^10.1.11",
    "@fastify/websocket": "^11.3.7",
    "fastify": "^5.12.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "ws": "^8.23.0"
  }
}
